pkgbase = jarvis-assistant
	pkgdesc = Voice assistant for your desktop: talks, sees the screen and gets things done (Gemini)
	pkgver = 2.1.0
	pkgrel = 1
	url = https://github.com/Qssaf/jarvis-assistant
	arch = x86_64
	license = MIT
	depends = uv
	depends = glib2
	depends = hicolor-icon-theme
	optdepends = pipewire: the microphone and speaker, with echo cancelling (or portaudio)
	optdepends = portaudio: the microphone and speaker without PipeWire
	optdepends = python-gobject: pressing app buttons by name (with at-spi2-core)
	optdepends = at-spi2-core: pressing app buttons by name
	optdepends = wdotool: mouse and keyboard control on Wayland
	optdepends = ydotool: typing on Wayland without wdotool
	optdepends = kdotool: finding, focusing and closing windows on KDE Wayland
	optdepends = spectacle: screenshots on KDE
	optdepends = grim: screenshots on wlroots desktops (Sway, Hyprland...)
	optdepends = gnome-screenshot: screenshots on GNOME
	optdepends = wl-clipboard: clipboard access on Wayland
	optdepends = xclip: clipboard access on X11
	optdepends = chromium: reading JavaScript-heavy web pages, and WhatsApp
	source = jarvis-assistant-2.1.0.tar.gz::https://github.com/Qssaf/jarvis-assistant/archive/refs/tags/v2.1.0.tar.gz
	source = jarvis.sh
	source = jarvis.desktop
	source = jarvis-screenshot.desktop
